# Copy to .env and fill in locally. .env is gitignored and must never be committed.
# Only the backend you use needs values.

# SharePoint / OneDrive (Microsoft Graph app registration)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Box (JWT or OAuth app)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_CONFIG_PATH=

# Google Drive (service account or OAuth client JSON, stored OUTSIDE the repo)
GOOGLE_CREDENTIALS_PATH=

# Local paths (outside the repo, or under the ignored data/ and output/ folders)
SOURCE_DIR=
TRACKER_PATH=
